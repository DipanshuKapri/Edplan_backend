COLLEGE_SCORECARD_API_KEY=
# Comma separated origins allowed for CORS (e.g., http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: explicitly list allowed hosts for TrustedHostMiddleware (use * to allow any)
ALLOWED_HOSTS=localhost,127.0.0.1
# Cache TTL (seconds) for in-memory response cache
CACHE_TTL_SECONDS=900
# Cache TTL (seconds) for readiness check against Scorecard API
READY_CHECK_CACHE_SECONDS=60
# Set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Public HTTP cache-control max-age for GET responses
PUBLIC_CACHE_SECONDS=60
# Public cache seconds override for programs endpoint
PROGRAMS_PUBLIC_CACHE_SECONDS=300
